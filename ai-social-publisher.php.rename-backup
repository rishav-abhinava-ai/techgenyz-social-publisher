/**
 * Creates the log table on activation.
 */
function aisp_activate() {
	AISP_Logger::create_table();
	AISP_Identity_Migration::run();
}
register_activation_hook( __FILE__, 'aisp_activate' );

/**
 * Boots admin-only functionality.
 */
function aisp_boot() {
	AISP_Identity_Migration::run();

	// REST routes must be registered on REST requests; all UI remains admin-only.
	AISP_Metabox::init();

	if ( is_admin() ) {
		if ( AISP_VERSION !== get_option( 'aisp_db_version' ) ) {
			AISP_Logger::create_table();
		}
		AISP_Settings::init();
	}
}
add_action( 'plugins_loaded', 'aisp_boot' );

/**
 * Adds a direct Settings link on the Plugins screen.
 *
 * @param array $links Existing plugin action links.
 * @return array
 */
function aisp_plugin_action_links( $links ) {
	$url = admin_url( 'admin.php?page=' . AISP_Settings::PAGE );
	array_unshift( $links, '<a href="' . esc_url( $url ) . '">' . esc_html__( 'Settings', 'ai-social-publisher' ) . '</a>' );
	return $links;
}
add_filter( 'plugin_action_links_' . plugin_basename( __FILE__ ), 'aisp_plugin_action_links' );
